# ==============================================================================
# Tumic Spices - Server-Side Configuration Template
# ==============================================================================

# Odoo Enterprise JSON-RPC API Credentials
ODOO_URL=https://your-instance.odoo.com
ODOO_DB=your_database_name
ODOO_USERNAME=your_integration_user_login
ODOO_API_KEY=your_odoo_user_api_key

# Admin Dashboard Secret PIN
ADMIN_SECRET_PIN=8604

# Meta WhatsApp Cloud API Credentials (Order Notifications)
# Get these from https://developers.facebook.com/apps/ > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_permanent_or_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_sender_phone_number_id
ADMIN_WHATSAPP_PHONE=918604446189
WHATSAPP_API_VERSION=v21.0
